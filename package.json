{
  "name": "unspooler",
  "version": "0.1.0",
  "description": "Video-first game asset pipeline: prompt to game-ready sprite sheets with pluggable models, AI matting, and a movement-test studio.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "unspooler": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "import": "./dist/controller/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && vite build --config studio/vite.config.ts",
    "build:lib": "tsup",
    "build:studio": "vite build --config studio/vite.config.ts",
    "dev:studio": "vite --config studio/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Punchbit/unspooler.git"
  },
  "keywords": [
    "sprites",
    "gamedev",
    "pixel-art",
    "sprite-sheet",
    "asset-pipeline",
    "image-to-video",
    "fal",
    "ai"
  ],
  "author": "Punchbit",
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@hono/node-server": "^1.19.0",
    "commander": "^14.0.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.9.6",
    "jiti": "^2.5.1",
    "replicate": "^1.1.0",
    "sharp": "^0.34.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
