{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "@controller": ["./src/controller/index.ts"]
    }
  },
  "include": ["src", "studio", "test"],
  "exclude": ["dist", "node_modules"]
}
